meta {
  name: Departamentos y municipios (DANE)
  type: http
  seq: 10
}

get {
  url: {{base_url}}/api/v1/locations/departments/68/municipalities
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.data[0].code: isString
  res.body.data[0].name: isString
}

docs {
  Municipios de Santander (68) con su código DANE de 5 dígitos. La lista de departamentos está en `/api/v1/locations/departments`. Público, sin token.
}
