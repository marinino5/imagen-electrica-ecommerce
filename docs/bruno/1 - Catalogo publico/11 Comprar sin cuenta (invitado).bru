meta {
  name: Comprar sin cuenta (invitado)
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/v1/checkout
  body: json
  auth: none
}

body:json {
  {
    "items": [{ "product_id": 1, "quantity": 1 }],
    "person_type": "company",
    "doc_number": "890903938",
    "nit_dv": "8",
    "company_name": "Empresa de Prueba S.A.S.",
    "fiscal_responsibility": "vat_responsible",
    "contact_name": "Laura Gómez",
    "billing_email": "facturacion@empresa-prueba.test",
    "phone": "3155550202",
    "billing_address": "Carrera 27 # 45-10",
    "department_code": "68",
    "city_code": "68001",
    "delivery_method": "pickup",
    "privacy_accepted": true,
    "website": ""
  }
}

assert {
  res.status: eq 201
  res.body.meta.guest: eq true
  res.body.data[0].is_guest: eq true
  res.body.data[0].billing.doc_type: eq NIT
}

docs {
  Compra sin cuenta con datos de facturación electrónica. Cambia `product_id` por uno que exista (GET /products). Con un NIT cuyo dígito de verificación no coincide responde 422 en `nit_dv`. Con `delivery_method: local` o `national` hay que mandar departamento, municipio, barrio, vía y número de entrega (o `delivery_same_as_billing: true`). Límite: 10 por minuto y 40 por hora por IP. `website` es el campo trampa contra bots: debe ir vacío.
}
