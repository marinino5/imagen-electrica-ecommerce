meta {
  name: Iniciar sesion admin
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
  }
}

script:post-response {
  bru.setVar("admin_token", res.body.token);
}

assert {
  res.status: eq 200
  res.body.data.role: eq admin
}
