meta {
  name: Eliminar producto
  type: http
  seq: 6
}

delete {
  url: {{base_url}}/api/v1/admin/products/{{new_product_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

assert {
  res.status: eq 204
}

docs {
  Borrado lógico: desaparece de la tienda, pero los pedidos antiguos conservan su copia.
}
