# URL base de la API (incluye /api/v1, sin barra final).
# Producción (Render):
VITE_API_URL=https://imagen-electrica-ecommerce.onrender.com/api/v1
# Backend local: VITE_API_URL=http://localhost:8000/api/v1

# Datos de contacto (opcionales; los datos reales están en src/config/site.js)
# VITE_WHATSAPP_NUMBER=573168219758
# VITE_EMAIL=imagenelectrica@gmail.com
# VITE_LEGAL_NAME=
# VITE_NIT=

# Solo para descargar fotos y videos con la API de Pixabay desde la computadora (scripts locales).
# NO lleva prefijo VITE_ (así Vite no la mete en el build) y el archivo .env nunca se sube a git.
# PIXABAY_API_KEY=
