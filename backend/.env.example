APP_NAME="Imagen Eléctrica"
APP_ENV=local
APP_KEY=
# Producción: false. Solo en desarrollo local se cambia a true.
APP_DEBUG=false
APP_URL=http://localhost:8000
# URL de la tienda (React): a donde apuntan los enlaces de los correos (recuperar contraseña)
STORE_URL=http://localhost:5173
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Producción: info (o warning). En local puede ser debug.
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=imagen_electrica
DB_USERNAME=imagen_electrica
DB_PASSWORD=
# Solo en producción (Aiven exige SSL): ruta del certificado CA, relativa a /backend
# MYSQL_ATTR_SSL_CA=docker/aiven-ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
QUOTE_NOTIFY_EMAIL=imagenelectrica@gmail.com
QUOTE_RESPONSE_TIME="en máximo 3 días hábiles"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Usuarios iniciales de los seeders (contraseñas solo en .env)
SEED_ADMIN_EMAIL=admin@imagenelectrica.test
SEED_ADMIN_PASSWORD=
SEED_COMERCIAL_EMAIL=comercial@imagenelectrica.test
SEED_COMERCIAL_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Envío: costo por modalidad y compra desde la cual es gratis (COP)
SHOP_FREE_SHIPPING_FROM=500000
SHOP_SHIPPING_LOCAL=15000
SHOP_SHIPPING_NATIONAL=35000

# Despliegue: si es true, el entrypoint corre db:seed --force en cada arranque (dejar en false tras la primera carga)
SEED_ON_DEPLOY=false

# Mientras la tienda no esté conectada con Siigo el stock es 0 y no se usa: todo producto con precio se compra.
# Al conectar Siigo, poner true (vuelven las reglas de inventario).
SHOP_TRACK_STOCK=false

# Arranque en Render (docker/entrypoint.sh): el servidor abre el puerto antes de migrar.
# RUN_MIGRATIONS_ON_START=false si las migraciones corren en el Pre-Deploy Command de Render.
RUN_MIGRATIONS_ON_START=true
MIGRATION_TIMEOUT=600
# Segundos máximos de espera por un bloqueo de MySQL (evita despliegues colgados en «Running migrations.»)
DB_LOCK_WAIT_TIMEOUT=60

# CORS: orígenes de la tienda (React) que pueden llamar a la API, separados por coma.
# Agrega aquí el dominio de Cloudflare Pages cuando exista (ej. https://imagen-electrica.pages.dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minutos de vida del token de la API (por defecto 10080 = 7 días)
SANCTUM_TOKEN_EXPIRATION=10080

# Tienda en React (Cloudflare Pages): imágenes y enlace de cotización de la ficha en PDF
FRONTEND_URL=https://imagen-electrica.pages.dev
